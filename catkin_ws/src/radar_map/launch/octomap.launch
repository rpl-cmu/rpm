<launch>
    <arg name="bag_files" />
    <arg name="dataset_path" default="/media/rpl/samsung/radar/sar/cic" />
    <arg name="pose_file" default="$(arg dataset_path)/pose/pose_imu_lio.txt" />
    <arg name="extrinsic_file" default="$(arg dataset_path)/config/T_sensor.yaml" />
    <arg name="save_map" default="$(arg dataset_path)/map/cfar.pkl" />

    <arg name="resolution" default="0.1" />
    <arg name="min_z" default="-0.5" />
    <arg name="max_z" default="0.5" />
    <arg name="max_range" default="10.0" />
    <arg name="doppler_thres" default="0.05" />

    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server">
        <param name="resolution" value="$(arg resolution)" />

        <!-- fixed map frame (set to 'map' if SLAM or localization running!) -->
        <param name="frame_id" type="string" value="map" />

        <param name="sensor_model/max_range" value="$(arg max_range)" />
        <param name="pointcloud_min_z" value="$(arg min_z)" />
        <param name="pointcloud_max_z" value="$(arg max_z)" />

        <!-- data source to integrate (PointCloud2) -->
        <remap from="cloud_in" to="filter_out" />

    </node>

    <node pkg="radar_map" type="sensor_pose.py" name="sensor_pose" output="screen">
        <param name="pose_file" value="$(arg pose_file)" />
        <param name="save_file" value="$(arg save_map)" />
        <param name="extrinsic_file" value="$(arg extrinsic_file)" />
        <remap from="cloud_out" to="filter_out" />
    </node>


    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find radar_map)/launch/vis.rviz" />

    <node pkg="rosbag" type="play" name="rosbag" args="--clock $(arg bag_files)"
        output="screen" required="true" />


</launch>